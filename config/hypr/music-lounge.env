# Пути music lounge (install.sh создаёт симлинки в ~/Videos/ из assets/music-lounge/)
MUSIC_LOUNGE_VIDEO="${MUSIC_LOUNGE_VIDEO:-$HOME/Videos/music-lounge-bg.mp4}"
MUSIC_LOUNGE_WIDGET_LEFT="${MUSIC_LOUNGE_WIDGET_LEFT:-$HOME/Videos/music-lounge/widget-left.gif}"
MUSIC_LOUNGE_WIDGET_RIGHT="${MUSIC_LOUNGE_WIDGET_RIGHT:-$HOME/Videos/music-lounge/widget-right.gif}"

# 1 = mpvpaper (слой обоев), 0 = mpv-окно без fullscreen
MUSIC_LOUNGE_USE_MPVPAPER="${MUSIC_LOUNGE_USE_MPVPAPER:-1}"

# Размеры
MUSIC_LOUNGE_VIZ_HEIGHT=140
MUSIC_LOUNGE_WIDGET_SIZE=260
