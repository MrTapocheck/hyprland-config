# Music lounge — Catppuccin Mocha

[general]
framerate = 60
bars = 14
bar_spacing = 2
bar_width = 3
autosens = 1
sensitivity = 100
lower_cutoff_freq = 50
higher_cutoff_freq = 12000

[input]
method = pipewire
source = auto

[output]
method = ncurses
channels = stereo

[color]
gradient = 1
gradient_count = 4
gradient_color_1 = '#89b4fa'
gradient_color_2 = '#cba6f7'
gradient_color_3 = '#f5c2e7'
gradient_color_4 = '#94e2d5'

[smoothing]
noise_reduction = 72
monstercat = 1
waves = 1
